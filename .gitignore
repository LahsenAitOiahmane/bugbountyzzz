# Public source allowlist. Local research and machine-specific files stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/scripts/
/scripts/*
!/scripts/js-collector/
!/scripts/check-public-files.mjs
!/scripts/export-tool.mjs

# Never publish dependencies, downloaded evidence, sessions or local secrets,
# even if they are accidentally written inside the public tool directory.
node_modules/
recon/
evidence/
programs/
research/
.env
.env.*
*.pem
*.key
*.har
*.pcap
*.pcapng
*.burp
*.session
cookies*.txt
storage-state*.json
auth-headers*.json
session-flow*.json
!scripts/js-collector/examples/session-flow.json
browser-last.*
javascript-corpus.zip
